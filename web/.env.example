# Supabase — client-safe values only. NEVER put the service-role key here or
# anywhere in this project; it must not exist in the Vercel web app at all.
# NEXT_PUBLIC_SUPABASE_ANON_KEY works with either the legacy "anon" key or the
# newer "publishable" key shown in the Supabase dashboard (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# coordinator-api — server-side only (not NEXT_PUBLIC_), used by
# confirm-upload to trigger pipeline processing. Unset in any environment
# where coordinator-api isn't running/deployed; that's handled gracefully.
# Must match coordinator-api's own INTERNAL_API_SECRET exactly.
COORDINATOR_API_URL=http://localhost:8080
INTERNAL_API_SECRET=
